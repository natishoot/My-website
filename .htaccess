# Hébergement o2switch (Apache). Fichier généré par tools/build_pages.py.

# Site en ligne et indexable. Restent en noindex (en-têtes envoyés par PHP) : galerie.php, photo.php, devis.php.

# Toujours https://natishoot.fr (sans www)
RewriteEngine On
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://natishoot.fr%{REQUEST_URI} [L,R=301]

# Anciennes pages prestations
Redirect 301 /prestations/portrait-mode.html /prestations/portrait.html
Redirect 301 /prestations/concerts-evenements.html /prestations/evenements-mariages.html
Redirect 301 /prestations/grossesse-intime.html /prestations/portrait.html
Redirect 301 /prestations/video-live.html /prestations/artistes.html
Redirect 301 /prestations/portrait-corporate.html /prestations/portrait.html
Redirect 301 /prestations/mode-concerts.html /prestations/mode.html
Redirect 301 /prestations/video-captation.html /prestations/artistes.html
Redirect 301 /prestations/photo-video.html /prestations/corporate-photo-video.html

# Fichiers de travail jamais servis
RedirectMatch 404 ^/(tools|\.git)(/|$)
<FilesMatch "\.(md|py|toml|txt)$">
  Require all denied
</FilesMatch>
<FilesMatch "^(robots|llms|[0-9a-f]{32})\.txt$">
  Require all granted
</FilesMatch>
<Files "galerie-lib.php">
  Require all denied
</Files>

# Sécurité et cache
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  <FilesMatch "\.(jpg|jpeg|png|webp|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
ErrorDocument 404 /index.html
